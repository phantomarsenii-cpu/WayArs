<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: use the launcher's own widget corner radius, so the launcher's clipping
     follows the green outline instead of cutting it off at the corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#F20E141B" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
    <stroke android:width="1dp" android:color="#3300E676" />
</shape>
