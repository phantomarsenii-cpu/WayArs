<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android 11+ (API 30+) package visibility: without this <queries>
      declaration, PackageManager.getInstalledApplications() and
      getLaunchIntentForPackage() only see this app itself plus a small
      set of always-visible system packages — confirmed on-device,
      2026-09-11: the "add app" picker in Settings showed almost nothing
      but system apps. Declaring interest in apps that have a launcher
      icon (MAIN/LAUNCHER) is the standard, Play-Store-compliant way to
      make the picker see every regular installed app (including Bolt,
      Wolt, Uber, FreeNow, etc.) without requesting the much heavier
      QUERY_ALL_PACKAGES permission, which needs a separate Play Console
      justification and isn't needed here — the picker only ever needs
      apps a person can actually open.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".WayArsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.WayArs"
        android:supportsRtl="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WayArs"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Read-only accessibility service: scans screen text, no clicks, no injection -->
        <service
            android:name=".service.accessibility.OrderAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Foreground service hosting the floating overlay widget -->
        <service
            android:name=".service.overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="wayars_floating_order_widget" />
        </service>

        <!-- Optional backstop: reads order notifications when the order app is
             minimized. Read-only, no notification actions are ever triggered.
             Requires a separate "Notification access" grant the user must
             enable manually in system Settings (not requested in-app yet). -->
        <service
            android:name=".service.notification.OrderNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Lets the Dashboard "share log" action hand a scan-log file (see
             ScanLogFile) to another app (Telegram, Mail, etc.) via a content://
             Uri, without exposing the whole app-private storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
